{
  "id": "#number",
  "title": "#string",
  "description": "#string",
  "category": "#string",
  "price": "#number? _ > 0",
  "discountPercentage": "#number",
  "rating": "#number? _ >= 0 && _ <= 5",
  "stock": "#number? _ >= 0",
  "tags": "#[] #string",
  "brand": "##string",
  "sku": "#string",
  "weight": "#number",
  "dimensions": {
    "width": "#number",
    "height": "#number",
    "depth": "#number"
  },
  "warrantyInformation": "#string",
  "shippingInformation": "#string",
  "availabilityStatus": "#regex (In Stock|Low Stock|Out of Stock)",
  "reviews": "#[_ > 0]",
  "returnPolicy": "#string",
  "minimumOrderQuantity": "#number",
  "meta": {
    "createdAt": "#string",
    "updatedAt": "#string",
    "barcode": "#string",
    "qrCode": "#string"
  },
  "images": "#[_ > 0] #string",
  "thumbnail": "#string"
}
